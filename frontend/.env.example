# AI Shield Frontend Environment Configuration Example
# Copy this file to .env or .env.local for local development.

# Target URL of the running Python Flask backend (used by Vite dev proxy)
VITE_BACKEND_URL=http://127.0.0.1:5000

# Client-side API route prefix (defaults to /api which proxies to VITE_BACKEND_URL)
VITE_API_BASE_URL=/api
